{
  "name": "idx-site",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Public site for the IDX working name",
  "scripts": {
    "build": "node build.mjs",
    "build:subpath": "SITE_BASE=/idx/ node build.mjs --out dist-subpath",
    "qa": "node scripts/qa.mjs",
    "images": "python3 scripts/images.py",
    "changelog": "node --experimental-strip-types --no-warnings scripts/sync-changelog.mjs",
    "releases": "node scripts/sync-releases.mjs",
    "audit": "node scripts/public-audit.mjs dist",
    "serve": "node scripts/serve.mjs dist 8765"
  },
  "engines": { "node": ">=22" }
}
